    "build:production": "node scripts/safe-build.js production android",
    "build:dev": "node scripts/safe-build.js development android",
    "build:force:preview": "eas build --profile preview --platform android",
    "build:force:production": "eas build --profile production --platform android",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --channel production",
    "workflow:preview": "eas workflow:run preview-android.yml",
    "workflow:production": "eas workflow:run production-android.yml",
    "workflow:dev": "eas workflow:run development.yml",
    "fingerprint": "eas fingerprint:generate",
    "submit:android": "eas submit --platform android --profile production",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
