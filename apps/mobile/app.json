{
  "expo": {
    "name": "Aube Sonore",
    "slug": "aube-sonore",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aubesonore",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.aubesonore.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "remote-notification"],
        "NSMicrophoneUsageDescription": "This app does not use the microphone",
        "NSBonjourServices": ["_googlecast._tcp", "_CC1AD845._googlecast._tcp"],
        "NSLocalNetworkUsageDescription": "Aube Sonore utilise le réseau local pour détecter les appareils Chromecast"
      }
    },
    "android": {
      "package": "fr.aubesonore.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0f1118"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#9370DB",
          "defaultChannel": "default"
        }
      ],
      [
        "react-native-google-cast",
        {
          "receiverAppId": "CC1AD845",
          "androidPlayServicesCastFrameworkVersion": "21.5.0"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f1118",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-asset",
      "expo-audio",
      "expo-image",
      "expo-sharing",
      "expo-web-browser"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5041fb33-9c20-4b21-95d0-309f91c96b17"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5041fb33-9c20-4b21-95d0-309f91c96b17"
      }
    },
    "owner": "victormoi"
  }
}
