{
  "expo": {
    "name": "Aube Sonore",
    "slug": "aube-sonore",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aubesonore",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1118"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.aubesonore.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSMicrophoneUsageDescription": "This app does not use the microphone",
        "NSBonjourServices": ["_googlecast._tcp", "_CC1AD845._googlecast._tcp"],
        "NSLocalNetworkUsageDescription": "Aube Sonore utilise le réseau local pour détecter les appareils de diffusion (Chromecast, AirPlay)"
      }
    },
    "android": {
      "package": "fr.aubesonore.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0f1118"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["FOREGROUND_SERVICE", "FOREGROUND_SERVICE_MEDIA_PLAYBACK", "WAKE_LOCK"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-google-cast",
        {
          "receiverAppId": "CC1AD845",
          "androidPlayServicesCastFrameworkVersion": "21.5.0"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f1118",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "androidPermissions": [
            "android.permission.MODIFY_AUDIO_SETTINGS",
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
          ],
          "androidForegroundService": true,
          "androidFSTypes": ["mediaPlayback"]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5041fb33-9c20-4b21-95d0-309f91c96b17"
      }
    },
    "owner": "victormoi"
  }
}
