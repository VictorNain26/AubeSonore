# Dockerfile.dev - Backend développement avec hot reload
FROM node:20-bullseye AS base

# Install system dependencies
RUN apt-get update && apt-get install -y \
  curl wget unzip bash python3 python3-pip python3-venv \
  build-essential postgresql-client \
  && rm -rf /var/lib/apt/lists/*

# Install Bun
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:$PATH"

WORKDIR /app

# ============================
# Development stage
# ============================
FROM base AS development

# Copy package files
COPY package.json bun.lock ./

# Install dependencies (including dev dependencies)
RUN bun install --no-cache

# Copy source code
COPY . .

# Ensure entrypoint is executable
RUN chmod +x /app/entrypoint.dev.sh

# Expose port and debugger port
EXPOSE 3000 9229

# Development command with hot reload and debugging
CMD ["/app/entrypoint.dev.sh"]

# ============================
# Production stage (fallback)
# ============================
FROM base AS production

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

COPY . .
RUN chmod +x /app/entrypoint.sh

EXPOSE 3000
CMD ["/app/entrypoint.sh"]