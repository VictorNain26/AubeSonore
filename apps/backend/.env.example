# Server Configuration
PORT=3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars
# Dev: http://localhost:3000
# Prod: https://api.aubesonore.fr
BETTER_AUTH_URL=http://localhost:3000

# URLs
# Dev: http://localhost:8080 / http://localhost:3000
# Prod: https://aubesonore.fr / https://api.aubesonore.fr
FRONTEND_BASE_URL=http://localhost:8080
BACKEND_BASE_URL=http://localhost:3000

# Google OAuth (optional - for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS
# Dev: http://localhost:8080,http://localhost:5173
# Prod: https://aubesonore.fr
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Cookie domain pour cross-subdomain (prod: .aubesonore.fr)
COOKIE_DOMAIN=
