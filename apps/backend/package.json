{
  "name": "@aubesonore/backend",
  "version": "1.0.0",
  "private": true,
  "module": "index.js",
  "type": "module",
  "scripts": {
    "dev": "bun src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "reset:all": "bun run src/scripts/reset-all.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:push": "DRIZZLE_KIT_NO_PROMPT=true bunx drizzle-kit push",
    "seed:admin": "bun run src/scripts/seed-admin.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aubesonore/shared-types": "workspace:*",
    "@elysiajs/cors": "^1.4.2",
    "@sinclair/typebox": "^0.34.0",
    "better-auth": "^1.6.11",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "html-to-text": "^10.0.0",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "valibot": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "@types/pg": "latest",
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.2.2",
    "typescript": "^5.8.3"
  }
}
