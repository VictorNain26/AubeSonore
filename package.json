{
  "name": "ourmusic",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:backend": "turbo dev --filter=@ourmusic/backend",
    "dev:frontend": "turbo dev --filter=@ourmusic/frontend",
    "build": "turbo build",
    "build:backend": "turbo build --filter=@ourmusic/backend",
    "build:frontend": "turbo build --filter=@ourmusic/frontend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0",
    "prettier": "^3.5.3",
    "turbo": "^2.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,css,html}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": ">=0.25.0"
    },
    "patchedDependencies": {
      "react-native-css-interop": "patches/react-native-css-interop.patch"
    }
  }
}
