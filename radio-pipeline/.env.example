# AzuraCast Configuration
# Copy this file to .env and fill in your values

# URL of your AzuraCast server (without trailing slash)
AZURACAST_URL=http://your-azuracast-server.com

# API Key from AzuraCast (Admin > API Keys)
AZURACAST_API_KEY=your-api-key-here

# Station ID (default: 1)
AZURACAST_STATION_ID=1
