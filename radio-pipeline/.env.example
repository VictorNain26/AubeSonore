# =============================================================================
# AubeSonore Radio Pipeline - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: AzuraCast Configuration
# -----------------------------------------------------------------------------

# AzuraCast server URL (HTTPS required in production)
# Example: https://radio.example.com
AZURACAST_URL=https://radio.example.com

# API Key from AzuraCast (Admin > API Keys > Create new)
# Must have permissions: Station Media, Station Playlists
AZURACAST_API_KEY=your-api-key-here

# Station ID (default: 1)
# Find it in AzuraCast URL: /station/1/...
AZURACAST_STATION_ID=1

# -----------------------------------------------------------------------------
# OPTIONAL: Metadata Enrichment APIs
# -----------------------------------------------------------------------------

# AcoustID API key for audio fingerprinting
# Get one at: https://acoustid.org/new-application
ACOUSTID_API_KEY=

# Last.fm API key for genre lookup
# Get one at: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL: Pipeline Settings
# -----------------------------------------------------------------------------

# Maximum tracks to discover per run (1-100, default: 30)
MAX_TRACKS_PER_RUN=30

# Download timeout in seconds (default: 300)
DOWNLOAD_TIMEOUT=300

# HTTP request timeout in seconds (default: 30)
HTTP_TIMEOUT=30

# Maximum HTTP retry attempts (0-10, default: 3)
MAX_RETRIES=3

# -----------------------------------------------------------------------------
# OPTIONAL: Security Settings
# -----------------------------------------------------------------------------

# Verify SSL certificates (default: true)
# Only set to false for local testing with self-signed certs
SSL_VERIFY=true

# Enable debug mode (default: false)
# Enables verbose logging and allows HTTP connections
DEBUG=false

# Allow HTTP connections (default: false)
# Set to 1 only if you REALLY can't use HTTPS
# ALLOW_HTTP=0
