{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separateMultipleMajorReleases"
  ],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "prConcurrentLimit": 10,
  "platformAutomerge": true,
  "minimumReleaseAge": "14 days",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Auto-merge pinning and digest re-pins (no functional change)",
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "Auto-merge devDependencies (minor + patch) once CI is green",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Auto-merge patch bumps of stable (>=1.0.0) runtime deps",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "Auto-merge GitHub Actions (minor + patch)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Never auto-merge majors — always manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Docker base image tag bumps: manual review (digest re-pins auto-merge via the rule above)",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "automerge": false
    }
  ]
}
