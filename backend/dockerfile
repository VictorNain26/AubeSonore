# Utiliser une image Node 18 Alpine
FROM node:18-alpine

# Installer les paquets nécessaires : Python3, Pip, pipx, bash et ffmpeg
RUN apk add --no-cache curl unzip bash python3 py3-pip py3-virtualenv pipx ffmpeg

# Forcer l'utilisation de bash pour les commandes RUN suivantes
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Installer Bun via le script officiel
RUN curl -fsSL https://bun.sh/install | bash

# Ajouter le répertoire d'installation de Bun au PATH
ENV PATH="/root/.bun/bin:${PATH}"

# Créer un environnement virtuel et installer spotdl avec pipx
RUN python3 -m venv /opt/spotdl-env && \
    /opt/spotdl-env/bin/pip install --no-cache-dir spotdl

# Ajouter le chemin de l'environnement virtuel au PATH pour exécuter spotdl
ENV PATH="/opt/spotdl-env/bin:${PATH}"

# Vérifier que spotdl est bien installé
RUN spotdl --version && which spotdl

# Définir le répertoire de travail
WORKDIR /app

# Copier les fichiers de dépendances
COPY package.json bun.lockb* ./

# Installer les dépendances avec Bun
RUN bun install

# Copier le reste du code source
COPY . .

# Exposer le port utilisé par l'application
EXPOSE 3000

# Démarrer l'application
CMD ["bun", "run", "--watch", "index.ts"]
