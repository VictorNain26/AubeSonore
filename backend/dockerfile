# Utiliser une image Node 18 Alpine
FROM node:18-alpine

# Installer les paquets nécessaires
RUN apk add --no-cache curl unzip bash python3 py3-pip pipx ffmpeg

# Installer Bun via le script officiel
RUN curl -fsSL https://bun.sh/install | bash

# Ajouter Bun au PATH
ENV BUN_INSTALL="/root/.bun"
ENV PATH="${BUN_INSTALL}/bin:${PATH}"

# Vérifier que Bun est bien installé
RUN bun --version

# Configurer pipx et installer spotdl proprement
ENV PIPX_BIN_DIR=/usr/local/bin
ENV PIPX_HOME=/usr/local/pipx
RUN pipx ensurepath
RUN pipx install spotdl --system-site-packages

# Vérifier que spotdl est bien installé
RUN spotdl --version && which spotdl

# Définir le répertoire de travail
WORKDIR /app

# Copier les fichiers de dépendances
COPY package.json bun.lockb* ./

# Installer les dépendances avec Bun
RUN bun install

# Copier le reste du code source
COPY . .

# Exposer le port utilisé par l'application
EXPOSE 3000

# Démarrer l'application
CMD ["bun", "run", "--watch", "index.js"]
