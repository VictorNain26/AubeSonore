# Use your existing base image
FROM node:18-alpine

# Install system dependencies
RUN apk add --no-cache curl unzip bash python3 py3-pip pipx ffmpeg chromium

# Install Bun (if you're using Bun)
RUN curl -fsSL https://bun.sh/install | bash
ENV BUN_INSTALL="/root/.bun"
ENV PATH="${BUN_INSTALL}/bin:${PATH}"

RUN bun --version

# Install spotdl + yt-dlp via pipx
ENV PIPX_BIN_DIR=/usr/local/bin
ENV PIPX_HOME=/usr/local/pipx
RUN pipx ensurepath
RUN pipx install spotdl --system-site-packages
RUN pipx install yt-dlp --system-site-packages

# Verify installations
RUN spotdl --version && which spotdl
RUN yt-dlp --version && which yt-dlp

RUN chromium --version

WORKDIR /app

# Copy dependencies + install them (adapt to your workflow)
COPY package.json bun.lockb* ./
RUN bun install

COPY . .

# >>>> COPY THE CHROMIUM PROFILE TO /root/.config/chromium/Default
COPY chromium-profile/Default /root/.config/chromium/Default

EXPOSE 3000

CMD ["bun", "index.js"]
