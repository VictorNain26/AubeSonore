{
  "name": "@aubesonore/core",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stats": {
      "types": "./dist/stats.d.ts",
      "default": "./dist/stats.js"
    },
    "./sleep-timer": {
      "types": "./dist/sleep-timer.d.ts",
      "default": "./dist/sleep-timer.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "default": "./dist/export.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./share": {
      "types": "./dist/share.d.ts",
      "default": "./dist/share.js"
    },
    "./lru-cache": {
      "types": "./dist/lruCache.d.ts",
      "default": "./dist/lruCache.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@aubesonore/shared-types": "workspace:*",
    "typescript": "^5.8.3"
  }
}
