# Copier en .env (jamais commité). Les variables sans valeur par défaut sont obligatoires
# pour les commandes qui s'en servent.

PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=
# Nom de la section musique Plex lue. Jamais « Musique second wave ».
PLEX_MUSIC_SECTION=Musique
PLEX_MUSIC_ROOT=/media/plex/Musique

LASTFM_API_KEY=

# Page de vote publiée par le tunnel Cloudflare, derrière Access (docs/exploitation.md).
RADIO_VOTES_URL=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Rappel WhatsApp (CallMeBot).
WHATSAPP_PHONE=
CALLMEBOT_APIKEY=

# Jeton du battement de cœur de la passe vers Gatus (deploy/gatus).
GATUS_TOKEN=
