# ===========================================
# AubeSonore - Configuration Docker
# ===========================================
# Copier ce fichier en .env et remplir les valeurs

# -------------------------------------------
# PostgreSQL Database
# -------------------------------------------
POSTGRES_USER=aubesonore
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=aubesonore

# -------------------------------------------
# Backend Configuration
# -------------------------------------------
# Better Auth - Clé secrète (minimum 32 caractères)
BETTER_AUTH_SECRET=your-super-secret-key-minimum-32-characters

# URLs de base
# Dev: localhost
# Prod: https://aubesonore.fr / https://api.aubesonore.fr
BETTER_AUTH_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:8080

# CORS - Origines autorisées (séparées par des virgules)
# Prod: https://aubesonore.fr
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Cookie domain pour cross-subdomain (prod: .aubesonore.fr)
COOKIE_DOMAIN=

# -------------------------------------------
# OAuth Providers (optionnel)
# -------------------------------------------
# Google OAuth - https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spotify OAuth - https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_DELAY_MS=500

# -------------------------------------------
# Features
# -------------------------------------------
# Activer les tâches CRON (scraping HypeMachine)
ENABLE_CRON=false

# Désactiver l'envoi d'emails (dev mode)
DISABLE_EMAILS=true

# -------------------------------------------
# AzuraCast Radio Configuration
# -------------------------------------------
# URL de l'instance AzuraCast (Hetzner)
AZURACAST_BASE_URL=http://116.203.46.203
# API Key (Settings > API Keys dans AzuraCast)
AZURACAST_API_KEY=
# ID de la station
AZURACAST_STATION_ID=1
# Chemin local si AzuraCast est sur la même machine (sinon laisser vide pour upload API)
AZURACAST_MEDIA_PATH=

# -------------------------------------------
# Frontend Configuration
# -------------------------------------------
# Prod: https://api.aubesonore.fr
VITE_API_URL=http://localhost:3000
# Prod: https://radio.aubesonore.fr
VITE_AZURACAST_BASE_URL=https://116.203.46.203
# Prod: https://aubesonore.fr
VITE_SITE_BASE_URL=http://localhost:8080
