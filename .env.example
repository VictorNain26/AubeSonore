# ===========================================
# OurMusic - Configuration Docker
# ===========================================
# Copier ce fichier en .env et remplir les valeurs

# -------------------------------------------
# PostgreSQL Database
# -------------------------------------------
POSTGRES_USER=ourmusic
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=ourmusic

# -------------------------------------------
# Backend Configuration
# -------------------------------------------
# Better Auth - Clé secrète (minimum 32 caractères)
BETTER_AUTH_SECRET=your-super-secret-key-minimum-32-characters

# URLs de base (adapter selon votre domaine)
BETTER_AUTH_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:8080

# CORS - Origines autorisées (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Cookie domain pour cross-subdomain (prod seulement, ex: .mondomaine.com)
COOKIE_DOMAIN=

# -------------------------------------------
# OAuth Providers (optionnel)
# -------------------------------------------
# Google OAuth - https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spotify OAuth - https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_DELAY_MS=500

# -------------------------------------------
# Features
# -------------------------------------------
# Activer les tâches CRON (scraping HypeMachine)
ENABLE_CRON=false

# Désactiver l'envoi d'emails (dev mode)
DISABLE_EMAILS=true

# -------------------------------------------
# Frontend Configuration
# -------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
VITE_AZURACAST_BASE_URL=https://your-azuracast-instance.com
VITE_SITE_BASE_URL=http://localhost:8080
