# AzuraCast — host-level compose settings.
# Copy to .env. No secrets belong here (those live in azuracast.env).

# Pin the image tag. "stable" tracks upstream releases.
AZURACAST_VERSION=stable

# Ports are remapped off their defaults: this box runs many other services
# (Jellyfin holds 8096, and 80/443 are taken by other stacks).
# Changing these means changing the published range in docker-compose.yml too.
AZURACAST_HTTP_PORT=8080
AZURACAST_HTTPS_PORT=8443
AZURACAST_SFTP_PORT=2022

# Must match the owner of stations/ on the host, or the container writes
# files the pipeline cannot read.
AZURACAST_PUID=1000
AZURACAST_PGID=1000
